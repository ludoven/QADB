+def _mount_qadb_bridge() -> None:
+    """Mount QADB control routes on this managed server, never a sidecar port."""
+    if os.environ.get("QADB_BRIDGE_ENABLED") != "1":
+        return
+    token = os.environ.get("QADB_BRIDGE_TOKEN")
+    ledger_path = os.environ.get("QADB_BRIDGE_LEDGER")
+    if not token or not ledger_path:
+        raise RuntimeError("QADB Bridge requires QADB_BRIDGE_TOKEN and QADB_BRIDGE_LEDGER")
+    from qadb_bridge import QadbBridge, SqliteBridgeLedger
+    from qadb_bridge_app import create_router
+
+    app.include_router(create_router(QadbBridge(token, ledger=SqliteBridgeLedger(ledger_path))))
+
+
+_mount_qadb_bridge()
+
+
 async def on_startup():
     """Startup lifecycle hooks."""
     state.is_shutting_down = False
